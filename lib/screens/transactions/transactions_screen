// lib/screens/transactions/transactions_screen.dart

import 'package:flutter/material.dart';
import 'widgets/transaction_tab_bar.dart';
import 'widgets/transaction_filters_row.dart';
import 'widgets/transaction_section.dart';
import 'widgets/transaction_fab.dart';
import 'models/transaction_ui_model.dart';

class TransactionsScreen extends StatefulWidget {
  const TransactionsScreen({super.key});

  @override
  State<TransactionsScreen> createState() => _TransactionsScreenState();
}

class _TransactionsScreenState extends State<TransactionsScreen> {
  int _selectedTab = 0;

  final List<Map<String, dynamic>> _sections = const [
    {'title': 'Today', 'transactionIds': [0, 1]},
    {'title': 'Yesterday', 'transactionIds': [2]},
    {'title': 'May 2026', 'transactionIds': [3, 4]},
  ];

  List<TransactionUIModel> _getTransactionsForTab(int tabIndex) {
    if (tabIndex == 0) {
      return dummyTransactions.where((t) => t.type == TransactionType.expense).toList();
    } else if (tabIndex == 1) {
      return dummyTransactions.where((t) => t.type == TransactionType.income).toList();
    } else if (tabIndex == 2) {
      return dummyTransactions.where((t) => t.type == TransactionType.transfer).toList();
    } else if (tabIndex == 3) {
      return dummyTransactions.where((t) => t.type == TransactionType.borrowLend).toList();
    } else if (tabIndex == 4) {
      return dummyTransactions.where((t) => t.type == TransactionType.payment).toList();
    }
    return dummyTransactions;
  }

  List<TransactionUIModel> _getTransactionsForSection(
    List<int> ids,
    List<TransactionUIModel> filteredTransactions,
  ) {
    return ids
        .where((id) => id < filteredTransactions.length)
        .map((id) => filteredTransactions[id])
        .toList();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF0F1115),
      appBar: AppBar(
        title: const Text(
          'Transactions',
          style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold),
        ),
        backgroundColor: Colors.transparent,
        elevation: 0,
        actions: [
          IconButton(
            icon: const Icon(Icons.search, color: Colors.white),
            onPressed: () {},
          ),
          IconButton(
            icon: const Icon(Icons.filter_list, color: Colors.white),
            onPressed: () {},
          ),
        ],
      ),
      body: Column(
        children: [
          TransactionTabBar(
            onTabChanged: (index) {
              setState(() {
                _selectedTab = index;
              });
            },
          ),
          const TransactionFiltersRow(),
          Expanded(
            child: LayoutBuilder(
              builder: (context, constraints) {
                final filteredTransactions = _getTransactionsForTab(_selectedTab);
                return ListView.builder(
                  padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                  itemCount: _sections.length,
                  itemBuilder: (context, index) {
                    final section = _sections[index];
                    final transactions = _getTransactionsForSection(
                      List<int>.from(section['transactionIds']),
                      filteredTransactions,
                    );
                    if (transactions.isEmpty) return const SizedBox.shrink();
                    return TransactionSection(
                      title: section['title'],
                      transactions: transactions,
                    );
                  },
                );
              },
            ),
          ),
        ],
      ),
      floatingActionButton: const TransactionFab(),
    );
  }
}